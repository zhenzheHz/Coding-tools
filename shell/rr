#!/usr/bin/env bash
# Compile and run the selected source with the same status display as rr_ref.
set -o pipefail
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
ORANGE='\033[38;5;208m'
RESET='\033[0m'
if [ -t 1 ]; then COLOR=1; else COLOR=0; fi
status() {
    if [ "$COLOR" = 1 ]; then printf '%b> %s%b\n' "$2" "$1" "$RESET"
    else printf '> %s\n' "$1"; fi
}
if (( $# > 1 )); then status 'Usage: rr [file.cpp]' "$ORANGE"; exit 1; fi
if (( $# == 1 )); then SOURCE=$1
elif [[ -f .cp-tools-current ]]; then IFS= read -r SOURCE < .cp-tools-current
else status 'CE' "$RED"; exit 1; fi
[[ $SOURCE == *.cpp ]] || SOURCE="$SOURCE.cpp"
if [[ ! -f $SOURCE ]]; then status 'CE' "$RED"; exit 1; fi
COMPILER=${CXX:-g++-16}
case "${SOURCE##*.}" in
    cpp) STANDARD=-std=c++17; EXTRA=(-DLOCAL "-I${CP_INCLUDE:-${CP_LIBRARY:-$(cd "$(dirname "$0")" && pwd)/../library}}") ;;
    c) COMPILER=${CC:-gcc}; STANDARD=-std=c17; EXTRA=() ;;
    *) status 'Compilation error' "$RED"; exit 1 ;;
esac
EXECUTABLE=$(mktemp "${TMPDIR:-/tmp}/rr.XXXXXX") || exit 1
STDOUT_FILE=$(mktemp "${TMPDIR:-/tmp}/rr_out.XXXXXX") || { rm -f "$EXECUTABLE"; exit 1; }
STDERR_FILE=$(mktemp "${TMPDIR:-/tmp}/rr_err.XXXXXX") || { rm -f "$EXECUTABLE" "$STDOUT_FILE"; exit 1; }
trap 'rm -f "$EXECUTABLE" "$STDOUT_FILE" "$STDERR_FILE"' EXIT HUP INT TERM
"$COMPILER" "$STANDARD" -O2 -Wall -Wextra "${EXTRA[@]}" "$SOURCE" -o "$EXECUTABLE"
if [ $? -ne 0 ]; then status 'Compilation error' "$RED"; exit 1; fi
status 'Finished.' "$ORANGE"
printf '\n'
START=$(python3 -c 'import time; print(time.monotonic_ns())')
"$EXECUTABLE" > "$STDOUT_FILE" 2> "$STDERR_FILE"
EXIT_CODE=$?
END=$(python3 -c 'import time; print(time.monotonic_ns())')
TIME=$(awk -v s="$START" -v e="$END" 'BEGIN { printf "%.2f", (e-s)/1000000 }')
if [ -s "$STDOUT_FILE" ]; then status 'stdout' "$GREEN"; cat "$STDOUT_FILE"; printf '\n'; fi
if [ -s "$STDERR_FILE" ]; then status 'stderr' "$YELLOW"; cat "$STDERR_FILE"; printf '\n'; fi
if [ "$EXIT_CODE" -ne 0 ]; then status 'Runtime Error' "$RED"; fi
printf '\n'
if [ "$COLOR" = 1 ]; then
    printf '%b[time : %s ms]%b\n' "$ORANGE" "$TIME" "$RESET"
    printf '%b[exit code : %s]%b\n' "$ORANGE" "$EXIT_CODE" "$RESET"
else
    printf '[time : %s ms]\n[exit code : %s]\n' "$TIME" "$EXIT_CODE"
fi
exit "$EXIT_CODE"
